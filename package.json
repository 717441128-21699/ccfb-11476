    "gen-dag": "node --disable-warning=ExperimentalWarning tools/gen-dag.ts",
    "verify": "node --disable-warning=ExperimentalWarning tools/verify.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
