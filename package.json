{
  "name": "dag-scheduler",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dependency-based data warehouse task scheduler with DAG, backfill, SLA and restart-safe execution",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start": "node --disable-warning=ExperimentalWarning src/cli.ts serve",
